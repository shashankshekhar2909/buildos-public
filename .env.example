COMPOSE_PROJECT_NAME=buildos

FRONTEND_PORT=4211
BACKEND_PORT=8012

BUILDOS_DATA_DIR=/app/data
PROJECTS_ROOT=/app/projects
PROJECTS_DISCOVERY_ROOTS=/app/projects
DATABASE_URL=sqlite:////app/data/buildos.db

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=change-me
SEED_PROFILE=generic
BUILDOS_GITHUB_URL=

# Frontend runtime API resolution.
# Leave blank to use dynamic host detection from browser hostname.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_PORT=8012
NEXT_PUBLIC_AUTH_MODE=local
APP_BASE_URL=http://localhost:4211

# Auth mode switch:
# local -> username/password validated in BuildOS DB, JWT issued by backend
# auth0 -> Auth0 Authorization Code flow in frontend, JWT validated by backend
AUTH_ENABLED=true
AUTH_MODE=local
AUTH_JWT_SECRET=change-me-local-jwt-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_TOKEN_TTL_SECONDS=43200

# Required only when AUTH_MODE=auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
AUTH0_SCOPE=openid profile email

# Optional docker visibility mode (used by docker-compose.docker.yml)
DOCKER_SOCKET_PATH=/var/run/docker.sock
